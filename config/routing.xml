<?xml version="1.0" encoding="utf-8" ?>
<osmand_routing_config defaultProfile="car" name="default">
	<attribute name="heuristicCoefficient" value="1.0" />
	<attribute name="zoomToLoadTiles" value="16" />
	<attribute name="planRoadDirection" value="0" />
	<attribute name="recalculateDistanceHelp" value="10000" />

	<routingProfile name="BromBrom" baseProfile="car" restrictionsAware="true" minSpeed="7.0" defaultSpeed="45.0" maxSpeed="45.0" sharpTurn="30" slightTurn="15" roundaboutTurn="15" onewayAware="true">
		<attribute name="penaltyForReverseDirection" value="300" />
		<attribute name="minPointApproximation" value = "50"/>
		<attribute name="minStepApproximation" value = "100"/>
		<attribute name="maxStepApproximation" value= "3000"/>
		<attribute name="smoothenPointsNoRoute" value = "5"/>


		<parameter id="avoid_toll" name="Avoid toll roads" description="Avoid toll roads" type="boolean"/>
		<parameter id="avoid_unpaved" name="Avoid unpaved roads" description="Avoid unpaved roads" type="boolean"/>
		<parameter id="avoid_low_emission_zone" name="Avoid low emission zones" description="Avoid low emission zones" type="boolean"/>
		<parameter id="prefer_unpaved" name="Prefer unpaved roads" description="Prefer unpaved roads" type="boolean"/>
		<parameter id="avoid_ferries" name="Avoid ferries" description="Avoid ferries" type="boolean"/>
		<parameter id="avoid_shuttle_train" name="Avoid Shuttle Trains" description="Avoid Shuttle Trains" type="boolean"/>
		<parameter id="avoid_tunnels" name="Avoid tunnels" description="Avoid tunnels" type="boolean"/>
		<parameter id="avoid_borders" name="Avoid border crossing" description="Avoid crossing a border into another country" type="boolean"/>
		<parameter id="avoid_ice_roads_fords" name="Avoid ice roads, fords" description="Avoid ice roads and fords" type="boolean"/>
		<parameter id="goods_restrictions" name="Goods restrictions" description="Respect goods restrictions" type="boolean"/>
		<parameter id="avoid_4wd_only" name="Avoid 4WD roads" description="Avoid roads only suitable for 4WD only vehicles" type="boolean"/>
		<parameter id="weight" name="Weight" description="Maximum vehicle weight to be permitted on the route" type="numeric" values="0,0.349,0.449,0.599,0.799,3.49" valueDescriptions="-,350kg,450kg,600kg,800kg,3.5t"/>
		<parameter id="height" name="Height" description="Maximum vehicle height to be permitted on the route" type="numeric" values="0,1.49,1.99,2.49,2.99" valueDescriptions="-,1.5m,2m,2.5m,3m"/>
		<parameter id="length" name="Length" description="Maximum vehicle length to be permitted on the route" type="numeric" values="0,2.49,2.99,3.49,3.99" valueDescriptions="-,2.5m,3m,3.5m,4m"/>
		<parameter id="width" name="Width" description="Maximum vehicle width to be permitted on the route" type="numeric" values="0,1.29,1.49,1.59,1.74" valueDescriptions="-,1.3m,1.5m,1.6m,1.75m"/>
		<parameter id="motor_type" name="Motor type" description="For CO2 computation" type="numeric" values="0,1,2,3,4,5,6" valueDescriptions="-,Petrol,Diesel,Lpg,Gas,Electric,Hybrid"/>

		<way attribute="access">
			<select value="-1" t="osmand_change" v="delete"/>
			<select value="-1" t="highway" v="proposed"/>
			<select value="-1" t="highway" v="construction"/>
			<select value="-1" t="construction" v="yes"/>
			<select value="-1" t="oneway" v="reversible"/>
			<if param="avoid_low_emission_zone">
				<select value="-1" t="low_emission_zone" v="yes"/>
			</if>
			<if param="avoid_ice_roads_fords">
				<select value="-1" t="ice_road" v="yes"/>
				<select value="-1" t="winter_road" v="yes"/>
				<select value="-1" t="ford" v="yes"/>
			</if>
			<if param="avoid_ferries">
			    <select value="-1" t="route" v="ferry"/>
			</if>
			<if param="avoid_shuttle_train">
			    <select value="-1" t="route" v="shuttle_train"/>
			</if>
			<if param="goods_restrictions">
				<select value="-1" t="goods" v="no"/>
			</if>
			<if param="avoid_4wd_only">
				<select value="-1" t="4wd_only" v="yes"/>
				<select value="-1" t="4wd_only" v="recommended"/>
			</if>
			<if param="avoid_unpaved">
				<select value="-1" t="highway" v="track"/>
				<select value="-1" t="surface" v="unpaved"/>
				<select value="-1" t="surface" v="compacted"/>
				<select value="-1" t="surface" v="dirt"/>
				<select value="-1" t="surface" v="gravel"/>
				<select value="-1" t="surface" v="fine_gravel"/>
				<select value="-1" t="surface" v="grass"/>
				<select value="-1" t="surface" v="ground"/>
				<select value="-1" t="surface" v="mud"/>
				<select value="-1" t="surface" v="pebblestone"/>
				<select value="-1" t="surface" v="sand"/>
				<select value="-1" t="smoothness" v="very_bad"/>
				<select value="-1" t="smoothness" v="horrible"/>
				<select value="-1" t="smoothness" v="very_horrible"/>
				<select value="-1" t="smoothness" v="impassable"/>
			</if>



			<select value="-1" t="motorcar" v="no"/>
			<select value="-1" t="motorcar" v="agricultural"/>
			<select value="-1" t="motorcar" v="forestry"/>
			<select value="1"  t="motorcar" v="yes"/>
			<if param="allow_private">
				<select value="1"  t="motorcar" v="private"/>
			</if>
			<select value="-1"  t="motorcar" v="private"/>
			<select value="1"  t="motorcar" v="permissive"/>
			<select value="1"  t="motorcar" v="designated"/>
			<select value="1"  t="motorcar" v="destination"/>
			<select value="1"  t="motorcar" v="customers"/>
			<select value="1"  t="motorcar" v="official"/>

			<select value="-1" t="motor_vehicle" v="no"/>
			<select value="-1" t="motor_vehicle" v="agricultural"/>
			<select value="-1" t="motor_vehicle" v="forestry"/>
			<select value="1"  t="motor_vehicle" v="yes"/>
			<if param="allow_private">
				<select value="1"  t="motor_vehicle" v="private"/>
			</if>
			<select value="-1"  t="motor_vehicle" v="private"/>
			<select value="1"  t="motor_vehicle" v="permissive"/>
			<select value="1"  t="motor_vehicle" v="designated"/>
			<select value="1"  t="motor_vehicle" v="destination"/>
			<select value="1"  t="motor_vehicle" v="customers"/>
			<select value="1"  t="motor_vehicle" v="official"/>

			<select value="-1" t="vehicle" v="no"/>
			<select value="-1" t="vehicle" v="agricultural"/>
			<select value="-1" t="vehicle" v="forestry"/>
			<select value="1"  t="vehicle" v="yes"/>
			<if param="allow_private">
				<select value="1"  t="vehicle" v="private"/>
			</if>
			<select value="-1"  t="vehicle" v="private"/>
			<select value="1"  t="vehicle" v="permissive"/>
			<select value="1"  t="vehicle" v="designated"/>
			<select value="1"  t="vehicle" v="destination"/>
			<select value="1"  t="vehicle" v="customers"/>

			<select value="-1" t="highway" v="cycleway"/>
			<select value="-1" t="highway" v="footway"/>
			<select value="-1" t="highway" v="path"/>
			<select value="-1" t="highway" v="pedestrian"/>
			<select value="-1" t="highway" v="bridleway"/>
			<select value="-1" t="highway" v="steps"/>

			<select value="-1" t="access" v="no"/>
			<select value="-1" t="access" v="agricultural"/>
			<select value="-1" t="access" v="forestry"/>
			<select value="-1" t="access" v="emergency"/>
			<select value="1"  t="access" v="yes"/>
			<if param="allow_private">
				<select value="1"  t="access" v="private"/>
			</if>
			<select value="-1"  t="access" v="private"/>
			<select value="1"  t="access" v="permissive"/>
			<select value="1"  t="access" v="destination"/>
			<select value="1"  t="access" v="customers"/>

			<select value="-1" t="maxweight">
				<gt value1=":weight" value2="$maxweight" type="weight"/>
			</select>
			<select value="-1" t="maxheight">
				<gt value1=":height" value2="$maxheight" type="length"/>
			</select>
			<select value="-1" t="maxlength">
				<gt value1=":length" value2="$maxlength" type="length"/>
			</select>
			<select value="-1" t="maxwidth">
				<gt value1=":width" value2="$maxwidth" type="length"/>
			</select>

			<select value="-1" t="highway" v="motorway"/>
			<select value="-1" t="highway" v="motorway_link"/>
			<select value="-1" t="highway" v="trunk"/>
			<select value="-1" t="highway" v="trunk_link"/>
			<select value="-1" t="motorroad" v="yes"/>
			<select value="-1" t="microcar" v="no"/>
			<select value="1" t="highway" v="primary"/>
			<select value="1" t="highway" v="primary_link"/>
			<select value="1" t="highway" v="secondary"/>
			<select value="1" t="highway" v="secondary_link"/>
			<select value="1" t="highway" v="tertiary"/>
			<select value="1" t="highway" v="tertiary_link"/>
			<select value="1" t="highway" v="unclassified"/>
			<select value="1" t="highway" v="road"/>
			<select value="1" t="highway" v="residential"/>
			<select value="1" t="highway" v="track"/>
			<select value="1" t="highway" v="service"/>
			<select value="1" t="highway" v="living_street"/>
			<if param="avoid_toll">
			    <select value="-1" t="toll" v="yes"/>
			</if>
			<select value="1" t="route" v="ferry"/>
			<select value="1" t="route" v="shuttle_train"/>
			<select value="-1"/>
		</way>

		<way attribute="oneway">
			<select value="1" t="oneway:motorcar" v="yes"/>
			<select value="0" t="oneway:motorcar" v="no"/>
			<select value="-1" t="oneway:motorcar" v="-1"/>
			<select value="1" t="oneway:motor_vehicle" v="yes"/>
			<select value="0" t="oneway:motor_vehicle" v="no"/>
			<select value="-1" t="oneway:motor_vehicle" v="-1"/>
			<select value="1" t="oneway:vehicle" v="yes"/>
			<select value="0" t="oneway:vehicle" v="no"/>
			<select value="-1" t="oneway:vehicle" v="-1"/>
			<select value="1" t="oneway" v="yes"/>
			<select value="1" t="oneway" v="1"/>
			<select value="-1" t="oneway" v="-1"/>
			<select value="1" t="roundabout"/>
			<select value="1" t="junction" v="roundabout"/>
		</way>

	<way attribute="penalty_transition">
			<!-- Consolidated transition penalties (removed short_way switch) -->
			<!-- roughly based on minimizing turn penalties for faster roads -->
			<select value="10" t="highway" v="primary"/>
			<select value="10" t="highway" v="primary_link"/>
			<select value="15" t="highway" v="secondary"/>
			<select value="15" t="highway" v="secondary_link"/>
			<select value="20" t="highway" v="tertiary"/>
			<select value="20" t="highway" v="tertiary_link"/>
			<select value="40" t="highway" v="service"/>
			
			<if param="avoid_tunnels">
				<select value="200" t="tunnel" v="yes"/>
			</if>
			<select value="100" t="surface" v="gravel"/>
			
			<!-- Fallback defaults -->
			<select value="25"/>
		</way>

		<way attribute="speed" type="speed">
			<!-- Explicitly respect lower speed limits -->
			<select value="5" t="maxspeed" v="5"/>
			<select value="10" t="maxspeed" v="10"/>
			<select value="15" t="maxspeed" v="15"/>
			<select value="20" t="maxspeed" v="20"/>
			<select value="30" t="maxspeed" v="30"/>
			<select value="40" t="maxspeed" v="40"/>
			
			<select value="5" t="maxspeed:motorcar" v="5"/>
			<select value="10" t="maxspeed:motorcar" v="10"/>
			<select value="15" t="maxspeed:motorcar" v="15"/>
			<select value="20" t="maxspeed:motorcar" v="20"/>
			<select value="30" t="maxspeed:motorcar" v="30"/>
			<select value="40" t="maxspeed:motorcar" v="40"/>

			<!-- Cap everything else at 45 km/h (Brommobiel limit) -->
			<!-- This ensures 80km/h roads provide NO time advantage over 45km/h roads -->
			<select value="45" t="highway" v="primary"/>
			<select value="45" t="highway" v="primary_link"/>
			<select value="45" t="highway" v="secondary"/>
			<select value="45" t="highway" v="secondary_link"/>
			<select value="45" t="highway" v="tertiary"/>
			<select value="45" t="highway" v="tertiary_link"/>
			<select value="45" t="highway" v="unclassified"/>
			<select value="45" t="highway" v="road"/>
			<select value="30" t="highway" v="residential"/>
			<select value="15" t="highway" v="track"/>
			<select value="30" t="highway" v="service"/>
			<select value="15" t="highway" v="living_street"/>
			<select value="10" t="route" v="ferry"/>
			<select value="45" t="route" v="shuttle_train"/>
		</way>

		<way attribute="priority">
			<select t="motorcar" v="private" value="0.15"/>
			<select t="motorcar" v="destination" value="0.15"/>
			<select t="motor_vehicle" v="private" value="0.15"/>
			<select t="motor_vehicle" v="destination" value="0.15"/>
			<select t="access" v="private" value="0.15"/>
			<select t="access" v="destination" value="0.15"/>
			<if param="avoid_toll">
				<select t="toll" v="yes" value="0.05"/>
			</if>
			<if param="avoid_borders">
				<select t="barrier" v="border_control" value="0.1"/>
			</if>

			<!-- Safety: De-prioritize high-speed roads -->
			<!-- Even though speed is capped at 45, we 'dislike' interacting with 80km/h traffic -->
			<select value="0.6" t="maxspeed" v="130"/>
			<select value="0.6" t="maxspeed" v="120"/>
			<select value="0.6" t="maxspeed" v="100"/>
			<select value="0.7" t="maxspeed" v="90"/>
			<select value="0.7" t="maxspeed" v="80"/>
			<select value="0.8" t="maxspeed" v="70"/>
			<select value="0.9" t="maxspeed" v="60"/>

			<select value="0.5" t="surface" v="gravel"/>
			<select value="0.5" t="surface" v="unpaved"/>
			
			<!-- Comfort: Brommobiels prefer smooth asphalt over clunky bricks -->
			<select value="1.1" t="surface" v="asphalt"/>
			<select value="1.1" t="surface" v="concrete"/>
			<select value="1.1" t="surface" v="paved"/>
			<select value="0.8" t="surface" v="sett"/>
			<select value="0.8" t="surface" v="cobblestone"/>
			<select value="0.7" t="surface" v="unhewn_cobblestone"/>
			
			<!-- Low Comfort: Avoid bad smoothness -->
			<select value="0.9" t="smoothness" v="intermediate"/>
			<select value="0.7" t="smoothness" v="bad"/>
			<select value="0.4" t="smoothness" v="very_bad"/>
			<select value="0.2" t="smoothness" v="horrible"/> 

			<if param="prefer_unpaved">
				<select value="1.2" t="surface" v="gravel"/>
				<select value="1.2" t="surface" v="unpaved"/>
				<select value="1.2" t="highway" v="track"/>
			</if>

			<!-- Preference: Balanced network usage -->
			<!-- We prefer 50km/h flow (Primary/Secondary) but penalize high-speed deltas via maxspeed tags above -->
			<select value="1.0" t="highway" v="primary"/>
			<select value="1.0" t="highway" v="primary_link"/>

			<select value="1.0" t="highway" v="secondary"/>
			<select value="1.0" t="highway" v="secondary_link"/>			
			<select value="1.0" t="highway" v="tertiary"/>
			<select value="1.0" t="highway" v="tertiary_link"/>
			<select value="1.0" t="highway" v="unclassified"/>
			<select value="1.0" t="highway" v="road"/>
			<select value="1.0" t="highway" v="residential"/>
			
			<select value="0.5" t="highway" v="track"/>
			<select value="0.6" t="highway" v="service"/>
			<select value="0.4" t="highway" v="living_street"/>
			<select value="0.5" t="route" v="ferry"/>
			<select value="0.5" t="route" v="shuttle_train"/>
			<select value="0.7"/>
		</way>

		<point attribute="obstacle_time">
			<select value="5"  t="barrier" v="entrance"/>
			<select value="15" t="barrier" v="gate"/>
			<select value="15" t="barrier" v="lift_gate"/>
			<select value="30" t="barrier" v="swing_gate"/>
			<select value="180" t="barrier" v="toll_booth"/>
			<select value="25" t="barrier"/>
			
			<!-- Brommobiels hate speed bumps (drempels) -->
			<select value="20" t="traffic_calming"/>
			
			<select value="20" t="highway" v="traffic_signals"/>
			<select value="15" t="highway" v="stop"/>
			<select value="10" t="highway" v="give_way"/>
		</point>

		<point attribute="obstacle">
			<select value="-1" t="motorcar" v="no"/>
			<select value="-1" t="motor_vehicle" v="no"/>
			<select value="-1" t="access" v="no"/>
			<select value="-1" t="barrier" v="bollard"/>
			<select value="-1" t="barrier" v="chain"/>
			<select value="5"  t="highway" v="give_way"/>
			<select value="15"  t="highway" v="stop"/>
			<select value="15" t="highway" v="traffic_signals"/>
			<select value="300" t="amenity" v="ferry_terminal"/>
		</point>
	</routingProfile>
</osmand_routing_config>
